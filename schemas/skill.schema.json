{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://alamia.ai/schemas/skill.schema.json",
 "title":"Alamia Skill Metadata","type":"object",
 "required":["id","name","description","domain","version"],
 "properties":{
  "id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
  "name":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},
  "domain":{"type":"string","pattern":"^[a-z0-9-]+$"},
  "version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
  "license":{"type":"string"},"tags":{"type":"array","items":{"type":"string"}},
  "compatibility":{"type":"array","items":{"type":"string"}},
  "requires":{"type":"array","items":{"type":"string"}},
  "risk":{"enum":["low","moderate","high"]}
 },"additionalProperties":false
}
